{
  "cleanupPeriodDays": 36500,
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sahuno/.local/bin/ledger-hook start",
            "timeout": 10,
            "statusMessage": "ledger: start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sahuno/.local/bin/ledger-hook stop",
            "timeout": 15,
            "statusMessage": "ledger: stop"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "frontend-design@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "bio-skills@sahuno": true,
    "bio-guardrails@sahuno": true,
    "hpc-site@sahuno": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "sahuno": {
      "source": {
        "source": "directory",
        "path": "/Users/sahuno/projects/llm_configs"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
