/*
 * Nextflow site profile — MSKCC HPC / Greenbaum Lab (account: greenbab)
 *
 * Author: Samuel Ahuno
 *
 * Include from a pipeline's own nextflow.config:
 *     includeConfig "${System.getenv('SITE_CONFIG')}/nextflow.config"
 *
 * Every value here is a site fact, not a preference. The partition names,
 * the account, and the GPU handling come from executor.yaml and the
 * `mskcc-hpc` skill; the container settings come from the apptainer env-leak
 * record in `singularity-build`. Another cluster copies this file and
 * replaces the values — see ../example/.
 *
 * Select with `-profile slurm` (or `slurm_short`, `gpu`, `test`).
 */

params {
    // Resolved from the site profile rather than hardcoded. Fail loudly if
    // unset: a silent fallback to a literal path is what the path registry
    // exists to prevent.
    site_config    = System.getenv('SITE_CONFIG')
    apptainer_cache = System.getenv('APPTAINER_CACHEDIR')
}

// ---------------------------------------------------------------------------
// Containers
// ---------------------------------------------------------------------------
apptainer {
    enabled    = true
    autoMounts = true
    // Must be on shared storage, not $HOME — otherwise every compute node
    // re-pulls layers and home quota fills.
    cacheDir   = params.apptainer_cache ?: "${System.getenv('HOME')}/.apptainer/cache"

    // RHEL 8 leaks host SSL/CA vars into the container. Inside the SIF those
    // paths do not exist, and any httpx-based client (huggingface_hub,
    // requests) dies at first HTTP-client construction — a *delayed* crash
    // that `--help` does not reveal. See the singularity-build skill's
    // references/env_leak.md.
    runOptions = '--cleanenv'
}

// ---------------------------------------------------------------------------
// Executor
// ---------------------------------------------------------------------------
executor {
    name            = 'slurm'
    queueSize       = 100
    submitRateLimit = '10/1min'
}

process {
    // NOTE: the cluster default partition `cpu` is DENIED for this account.
    // A bare submission with no partition fails with "Invalid account or
    // account/partition combination specified", so a default must always be
    // set explicitly. See mskcc-hpc/references/mskcc_partitions.md.
    executor      = 'slurm'
    queue         = 'componc_cpu'
    clusterOptions = '--account=greenbab'

    cpus = 4

    // /data1 is a shared filesystem. Default caching hashes on the last-modified
    // timestamp, which NFS-class filesystems report inconsistently — resume then
    // re-runs tasks whose inputs never changed, which is the single thing most
    // likely to make people stop trusting -resume. 'lenient' hashes on path and
    // size only.
    cache = 'lenient'

    // Retry the failures worth retrying. OOM is the important one: under
    // Nextflow an OOM-killed task fails visibly and is resubmitted with more
    // memory, where the equivalent under an mclapply fan-out returns NULL and
    // the parent exits 0. Escalating memory per attempt is the point — repeating
    // the same request just fails three times more slowly.
    errorStrategy = { task.exitStatus in [104, 125, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 3
    memory        = { 16.GB * task.cpus * task.attempt }
    time          = { 90.m * task.attempt }

    withLabel: short {
        // cpushort routinely has 50+ idle nodes on the same Xeon Gold 6348
        // hardware, 2 h limit. Prefer it for per-sample work under 2 h.
        queue = 'cpushort'
        time  = { 100.m * task.attempt }
    }

    withLabel: long {
        queue = 'componc_cpu'
        time  = { 24.h * task.attempt }
    }

    withLabel: gpu {
        queue          = 'componc_gpu_batch'
        clusterOptions = '--account=greenbab --gres=gpu:4'
        cpus           = 8
        memory         = { 24.GB * task.cpus * task.attempt }
    }

    withLabel: benchmark {
        // isca071 ran 35% slower than the rest of cpushort with identical
        // SLURM-visible attributes. Exclude it or benchmark numbers are noise.
        queue          = 'cpushort'
        clusterOptions = '--account=greenbab --exclude=isca071'
    }
}

// ---------------------------------------------------------------------------
// Reporting — issue #12 item 2, "detailed logging and workflow metadata"
//
// These are the reason to prefer Nextflow here. Snakemake needs this wired by
// hand; Nextflow emits it for free, and the trace file is what makes a resource
// study (see the runtime-resource-study skill) a query rather than a project.
// ---------------------------------------------------------------------------
def ts = new java.util.Date().format('yyyyMMdd_HHmmss')

timeline { enabled = true; file = "results/pipeline_info/timeline_${ts}.html" }
report   { enabled = true; file = "results/pipeline_info/report_${ts}.html" }
trace    {
    enabled = true
    file    = "results/pipeline_info/trace_${ts}.txt"
    // peak RSS and %cpu are what right-size a rerun; the defaults omit them.
    fields  = 'task_id,hash,name,status,exit,attempt,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
dag      { enabled = true; file = "results/pipeline_info/dag_${ts}.html" }

// Resume is the headline reason for the transition, but it is a launch flag,
// not a config option — run `nextflow run . -resume`. The `process.cache`
// setting above is what makes that flag behave correctly on this filesystem.

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {
    slurm       { /* defaults above */ }
    slurm_short { process.queue = 'cpushort'; process.time = { 100.m * task.attempt } }
    gpu         { process.queue = 'componc_gpu_batch' }
    test        {
        // Local smoke test: no scheduler, no containers, tiny resources.
        process.executor = 'local'
        process.queue    = null
        apptainer.enabled = false
        process.cpus     = 1
        process.memory   = '2.GB'
        process.time     = '10m'
    }
}
