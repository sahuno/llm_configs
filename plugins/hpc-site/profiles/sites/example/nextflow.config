/*
 * Nextflow site profile — TEMPLATE
 *
 * Copy with the rest of sites/example/ and fill in. Include from a pipeline:
 *     includeConfig "${System.getenv('SITE_CONFIG')}/nextflow.config"
 *
 * sites/mskcc-greenbaum/nextflow.config is a filled-in example. Its values will
 * not transfer; the structure and the questions will.
 */

params {
    site_config     = System.getenv('SITE_CONFIG')
    apptainer_cache = System.getenv('APPTAINER_CACHEDIR')
}

apptainer {
    enabled    = true
    autoMounts = true
    // Put this on shared storage, not $HOME, or every node re-pulls layers.
    cacheDir   = params.apptainer_cache ?: "${System.getenv('HOME')}/.apptainer/cache"
    // '--cleanenv' if your host exports SSL_CERT_FILE / SSL_CERT_DIR pointing at
    // paths absent inside the container — the resulting crash is delayed until
    // the first HTTP client is constructed, so `--help` looks fine.
    // runOptions = '--cleanenv'
}

executor {
    name      = 'slurm'          // slurm | sge | lsf | local
    queueSize = 100
}

process {
    executor       = 'slurm'
    // Check which partitions your account may actually use before setting this:
    //   scontrol show partition <name>   → look at DenyAccounts
    // Do not assume the cluster-wide default is available to you.
    queue          = '<your-default-partition>'
    clusterOptions = '--account=<your-account>'

    cpus = 4

    // 'lenient' hashes inputs on path and size, not timestamp. Use it if your
    // work directory is on NFS or similar, where inconsistent timestamps
    // invalidate the cache and make -resume re-run unchanged tasks.
    cache = 'lenient'

    errorStrategy = { task.exitStatus in [104, 125, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 3
    memory        = { 16.GB * task.cpus * task.attempt }
    time          = { 90.m * task.attempt }

    withLabel: short { queue = '<short-queue>' }
    withLabel: long  { queue = '<long-queue>';  time = { 24.h * task.attempt } }
    withLabel: gpu   {
        queue          = '<gpu-partition>'
        clusterOptions = '--account=<your-account> --gres=gpu:1'
    }
    // If any node in a nominally uniform partition is slower, exclude it here
    // for benchmarking — otherwise your timings are noise.
    // withLabel: benchmark { clusterOptions = '--account=<acct> --exclude=<node>' }
}

def ts = new java.util.Date().format('yyyyMMdd_HHmmss')
timeline { enabled = true; file = "results/pipeline_info/timeline_${ts}.html" }
report   { enabled = true; file = "results/pipeline_info/report_${ts}.html" }
trace    {
    enabled = true
    file    = "results/pipeline_info/trace_${ts}.txt"
    fields  = 'task_id,hash,name,status,exit,attempt,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
dag      { enabled = true; file = "results/pipeline_info/dag_${ts}.html" }

profiles {
    slurm { /* defaults above */ }
    test  {
        process.executor  = 'local'
        process.queue     = null
        apptainer.enabled = false
        process.cpus      = 1
        process.memory    = '2.GB'
        process.time      = '10m'
    }
}
