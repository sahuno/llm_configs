share/claude/tmp
claude/tests/logs/*.log
sandbox/
setup/

# Local Claude env vars (secrets) — template is committed, .local.sh is not
claude/profiles/env/claude_env.local.sh
claude/profiles/env/*.local.sh

# Skill development workspaces (iteration scratch — not part of the skill)
claude/skills/*-workspace/

# Python bytecode (always regenerated; version-specific)
__pycache__/
*.pyc

# Claude Code per-project runtime/local config — ignore everything except
# project-shared settings.json (keep an escape hatch for future shared config).
.claude/*
!.claude/settings.json
